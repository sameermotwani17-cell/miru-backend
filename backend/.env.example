# Postgres / Supabase. Use the POOLER connection string (port 6543), not the
# direct db host — each serverless invocation may open its own connection.
DATABASE_URL=postgresql://user:pass@host:6543/postgres?sslmode=require

# Required: interview generation and scoring (gpt-4o-mini)
OPENAI_API_KEY=

# Optional: server-side text-to-speech. Without these, voice_audio is empty
# and the interview still runs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: comma-separated CORS allowlist. Defaults to "*".
# ALLOWED_ORIGINS=https://miru.vercel.app

# Dev only: return canned LLM responses so the gauntlet runs without an
# OpenAI key. Never set this in production.
# MIRU_STUB_LLM=1
